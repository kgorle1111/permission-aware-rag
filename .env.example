# ---- storage -----------------------------------------------------------------
# default: sqlite ./rag.db + embedded Qdrant in ./qdrant_data (zero infra)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/permrag
# QDRANT_URL=http://localhost:6333        # run a Qdrant server instead of embedded

# ---- identity ------------------------------------------------------------------
# Local IdP keypair (created by: python scripts/gen_keys.py)
# JWT_PUBLIC_KEY_PATH=config/idp_public.pem
# Production: point at your real IdP instead and never hold a private key here:
# JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
JWT_AUDIENCE=permission-rag-api

# ---- embeddings (LOCAL by design — confidential text never leaves this box) ----
EMBED_BACKEND=hash          # hash (zero-dep) | st (sentence-transformers, better recall)
EMBED_DIM=384

# ---- retrieval -----------------------------------------------------------------
TOP_K=4
CACHE_TTL_S=300

# ---- generation (optional; extractive answers when unset) ----------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-haiku-4-5

# ---- permission sync -------------------------------------------------------------
PERMISSIONS_SOURCE=corpus/permissions.jsonl

# ---- demo ------------------------------------------------------------------------
DEMO_MODE=1                 # serves /demo/tokens for the UI user-picker. NEVER in prod.
